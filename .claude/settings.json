{
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git -C * push --force*)",
      "Bash(git -C * push -f)",
      "Bash(git -C * push -f *)",
      "Bash(git -C * push * --force*)",
      "Bash(git -C * push * -f)",
      "Bash(git -C * push * -f *)",
      "Bash(git -C * push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git -C * reset * --hard*)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "test -f \"${CLAUDE_PROJECT_DIR}/tools/claude/handoff_hook.py\" && python3 \"${CLAUDE_PROJECT_DIR}/tools/claude/handoff_hook.py\" || true",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
